# 반드시 변경하세요 — 256비트 랜덤 문자열 권장
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION

# 토큰 만료 시간 (분)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── 팀원 모델 서버 연결 ────────────────────────────────────────
# 팀원 Tailscale IP : 포트
MODEL_SERVER_URL=http://100.127.247.71:8888

# 모델 추론 타임아웃 (초, 기본 300 = 5분)
MODEL_TIMEOUT=300

# 모델 서버 연결 실패 시 Mock으로 fallback할지 여부
# true = 연결 실패해도 목업 결과로 계속 동작 (현재)
# false = 연결 실패 시 오류 반환
MODEL_MOCK_FALLBACK=true

# ── Claude AI 설명 기능 ────────────────────────────────────────
# Anthropic API 키를 입력하세요 (없으면 규칙 기반 설명으로 동작)
ANTHROPIC_API_KEY=여기에_실제_API_키_붙여넣기
