# 반드시 변경하세요 — 256비트 랜덤 문자열 권장
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION

# 토큰 만료 시간 (분)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── 팀원 모델 서버 연결 ────────────────────────────────────────
# 팀원 Tailscale IP와 포트를 입력하세요 (기본 포트: 5000)
MODEL_SERVER_URL=http://<팀원-Tailscale-IP>:5000

# 모델 추론 타임아웃 (초, 기본 300 = 5분)
MODEL_TIMEOUT=300

# 모델 서버 연결 실패 시 Mock으로 fallback할지 여부 (true/false)
# true  = 연결 실패해도 목업 결과로 계속 동작 (개발/테스트용)
# false = 연결 실패 시 오류 반환 (프로덕션용)
MODEL_MOCK_FALLBACK=true

# ── Claude AI 설명 기능 ────────────────────────────────────────
# Anthropic API 키 — 없으면 규칙 기반 fallback 설명 사용
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-
